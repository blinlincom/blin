# 仅监听本机，禁止直接暴露公网。
TRON_WALLET_LISTEN=127.0.0.1:9088

# TP8 与钱包服务之间的 HMAC 密钥，生产至少 32 个随机字符。
TRON_INTERNAL_SECRET=

# HD 主种子十六进制。生产环境必须由 HSM/KMS 或隔离密钥系统提供。
# 未配置时服务可以启动，但不会生成充值地址。
TRON_MASTER_SEED_HEX=

# 后续链扫描和广播使用的节点配置。未配置时充值扫描和提币广播保持关闭。
TRON_FULLNODE_URL=
TRON_SOLIDITYNODE_URL=
TRON_API_KEY=

# TRON 已确认事件查询接口。首期使用 TronGrid，后续可切换自建事件服务。
TRON_EVENT_API_URL=https://api.trongrid.io

# TP8 callback 应用地址，只能由服务器本机访问或通过内网访问。
TRON_CALLBACK_URL=http://127.0.0.1/callback

# 链上资金任务总开关。完成热钱包、资源钱包和归集地址配置并小额验收前必须为 false。
TRON_CHAIN_WORKER_ENABLED=false
TRON_WORKER_ID=wallet-1

# 资源钱包私钥，用于给用户充值地址补足执行 TRC20 归集所需的 TRX。
# 只填 64 位十六进制私钥，不填地址；服务会计算地址并在健康检查中显示。
TRON_RESOURCE_PRIVATE_KEY=
TRON_RESOURCE_TOPUP_SUN=30000000

# 提现热钱包私钥。该钱包必须持有待提 USDT 及足够 TRX/Energy。
TRON_WITHDRAW_HOT_PRIVATE_KEY=

# GasFree默认关闭。API凭据、签名测试向量和小额验收全部通过后才能开启。
TRON_GASFREE_ENABLED=false
TRON_GASFREE_AUTO_ENABLED=false
TRON_GASFREE_API_URL=https://open.gasfree.io/tron
TRON_GASFREE_API_KEY=
TRON_GASFREE_API_SECRET=
TRON_GASFREE_CHAIN_ID=728126428
TRON_GASFREE_VERIFYING_CONTRACT=TFFAMQLZybALaLb4uxHA9RBE7pxhUAjF3U
TRON_GASFREE_MAX_TRANSFER_FEE_USDT=2.000000
TRON_GASFREE_MAX_FIRST_FEE_USDT=4.000000
TRON_GASFREE_MIN_NET_AMOUNT_USDT=10.000000
TRON_GASFREE_MAX_FEE_RATE_PERCENT=10.00
